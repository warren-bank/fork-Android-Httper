<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="org.mushare.httper">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- FOREGROUND_SERVICE_DATA_SYNC: required by Android >= 14 to start a FGS w/ foregroundServiceType="dataSync" -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- file access permissions: Android 1 to 10 -->
    <!-- note: Android 10 requires "requestLegacyExternalStorage" -->
    <uses-permission android:maxSdkVersion="29" android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- file access permissions: Android 11+ -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <application
        android:name=".utils.MyApp"
        android:label="@string/app_name"
        android:theme="@style/AppTheme.NoActionBar"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:supportsRtl="false">
        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:windowSoftInputMode="adjustPan"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name=".ResponseActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="false"/>
        <activity
            android:name=".RequestHistoryActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="false"/>
        <activity
            android:name=".AboutActivity"
            android:label="@string/main_view_about"
            android:theme="@style/AppTheme"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="false"/>
        <service
            android:name=".PeriodicRequestsService"
            android:foregroundServiceType="dataSync"
            android:enabled="true"
            android:exported="true"/>
    </application>

</manifest>
